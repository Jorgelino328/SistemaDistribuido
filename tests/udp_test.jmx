        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="UDP - UserService Info" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.DatagramPacket
import java.net.DatagramSocket
import java.net.InetAddress

def host = &quot;localhost&quot;
def port = 8082

def request = &quot;userservice|INFO&quot;
def requestBytes = request.getBytes(&quot;UTF-8&quot;)

def socket = new DatagramSocket()
socket.setSoTimeout(5000)

try {
    def address = InetAddress.getByName(host)
    def sendPacket = new DatagramPacket(requestBytes, requestBytes.length, address, port)
    socket.send(sendPacket)
    
    def receiveBuffer = new byte[65507]
    def receivePacket = new DatagramPacket(receiveBuffer, receiveBuffer.length)
    socket.receive(receivePacket)
    
    def response = new String(receivePacket.getData(), 0, receivePacket.getLength(), &quot;UTF-8&quot;)
    SampleResult.setResponseData(response, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(true)
} catch (Exception e) {
    SampleResult.setResponseData(&quot;Error: &quot; + e.getMessage(), &quot;UTF-8&quot;)
    SampleResult.setSuccessful(false)
} finally {
    socket.close()
}
</stringProp>
        </JSR223Sampler>
