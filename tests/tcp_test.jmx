        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TCP - UserService Info" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.Socket
import java.io.BufferedReader
import java.io.InputStreamReader
import java.io.PrintWriter

def gatewayHost = &quot;localhost&quot;
def gatewayPort = 8081

def makeTcpRequest = { host, port, request -&gt;
    def socket = new Socket(host, port)
    socket.setSoTimeout(10000)
    try {
        def out = new PrintWriter(socket.getOutputStream(), true)
        def in = new BufferedReader(new InputStreamReader(socket.getInputStream()))
        
        out.println(request)
        def response = in.readLine()
        
        return response ?: &quot;&quot;
    } finally {
        socket.close()
    }
}

try {
    def request = &quot;userservice|INFO&quot;
    def response = makeTcpRequest(gatewayHost, gatewayPort, request)
    
    SampleResult.setResponseData(response, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(response.contains(&quot;UserService&quot;))
    
} catch (Exception e) {
    SampleResult.setResponseData(&quot;Error: ${e.message}&quot;, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(false)
    log.error(&quot;Request failed&quot;, e)
}
</stringProp>
        </JSR223Sampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Assertion" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-944811958">UserService</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TCP - User Create Key A" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.Socket
import java.io.BufferedReader
import java.io.InputStreamReader
import java.io.PrintWriter

def gatewayHost = &quot;localhost&quot;
def gatewayPort = 8081
def threadNum = ctx.getThreadNum()
def username = &quot;alice_${threadNum}&quot;
def email = &quot;alice${threadNum}@test.com&quot;

def makeTcpRequest = { host, port, request -&gt;
    def socket = new Socket(host, port)
    socket.setSoTimeout(10000)
    try {
        def out = new PrintWriter(socket.getOutputStream(), true)
        def in = new BufferedReader(new InputStreamReader(socket.getInputStream()))
        
        out.println(request)
        def response = in.readLine()
        
        return response ?: &quot;&quot;
    } finally {
        socket.close()
    }
}

try {
    // First attempt - to gateway
    def request = &quot;userservice|USER_CREATE|${username}|${email}&quot;
    def response = makeTcpRequest(gatewayHost, gatewayPort, request)
    
    // Check if redirect
    if (response.startsWith(&quot;REDIRECT|&quot;)) {
        def parts = response.split(/\|/)
        if (parts.length &gt;= 4) {
            def redirectHost = parts[2]
            def httpPort = parts[3] as Integer
            def tcpPort = httpPort + 1
            log.info(&quot;Redirect detected to ${redirectHost}:${tcpPort}&quot;)
            
            def directRequest = &quot;USER_CREATE|${username}|${email}&quot;
            response = makeTcpRequest(redirectHost, tcpPort, directRequest)
        }
    }
    
    SampleResult.setResponseData(response, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(response.startsWith(&quot;SUCCESS&quot;))
    
} catch (Exception e) {
    SampleResult.setResponseData(&quot;Error: ${e.message}&quot;, &quot;UTF-8&quot;)
    SampleResult.setSuccessful(false)
    log.error(&quot;Request failed&quot;, e)
}
</stringProp>
        </JSR223Sampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Assertion" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-1149187101">SUCCESS</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
          </ResponseAssertion>
